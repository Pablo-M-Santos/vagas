{
  "name": "vagas-backend",
  "version": "1.0.0",
  "description": "Agregador de vagas de TI",
  "main": "dist/index.js",
  "scripts": {
    "db:push": "npx prisma db push",
    "build": "npx prisma generate && tsc && npx prisma db push",
    "start": "node dist/index.js",
    "dev:backend": "ts-node src/index.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "./dev.sh",
    "worker:run-once": "ts-node src/index.ts",
    "web": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "web:start": "npm --prefix frontend run start",
    "web:test": "npm --prefix frontend run test"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.19.0",
    "apify-client": "^2.3.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.7",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
