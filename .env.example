# .env.example - Configurações do DevScout

# Banco de Dados SQLite (ou PostgreSQL se configurado via Docker)
# Para SQLite local padrão:
DATABASE_URL="file:./prisma/vagas.db"

# Token da sua conta Apify (apify.com -> Settings -> Integrations)
APIFY_API_TOKEN="seu_token_apify_aqui"

# ID do Actor de scraping do LinkedIn na Apify (ex: hKGsXqqfdEBZXbTxk)
APIFY_LINKEDIN_ACTOR_ID="seu_actor_id_aqui"

# Token gerado pelo @BotFather no Telegram para alertas em tempo real
TELEGRAM_BOT_TOKEN="seu_token_telegram_bot_aqui"

# ID do canal ou chat do Telegram onde os alertas serão disparados
TELEGRAM_CHAT_ID="seu_chat_id_aqui"

# Frequência de execução do cron worker (ex: a cada 2 horas)
SCRAPE_INTERVAL_CRON="0 */2 * * *"

# Filtros padrões de busca e telemetria
KEYWORDS_FILTER="junior, desenvolvedor, frontend, backend, fullstack, software, estagio"
LOCATION_FILTER="Brasil"
